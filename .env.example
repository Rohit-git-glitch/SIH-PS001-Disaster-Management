# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/landslide_monitoring
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/landslide_monitoring?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/landslide_monitoring

# CORS Configuration
CLIENT_URL=http://localhost:3000

# ML Inference Configuration (Phase 4C)
# Path to the Python executable (e.g. python3, or full venv path)
ML_PYTHON_PATH=python

# Paths below default to ml_inference/ relative to Backend root if omitted
# ML_INFERENCE_SCRIPT=./ml_inference/predict.py
# ML_MODEL_PATH=./ml_inference/assam_landslide_xgb_model.json
# ML_INPUT_DIR=./ml_inference/inputs
# ML_OUTPUT_DIR=./ml_inference/outputs
